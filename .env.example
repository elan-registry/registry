# Elan Registry — environment variable template
#
# Three env files, each read by different tools (details:
# docs/development/ENVIRONMENT.md "Which File Is Read by What"):
#   .env             PHP app, Phinx, Docker Compose. Everything in this file
#                    above the ".env.local ONLY" divider goes here.
#   .env.local       Playwright only. Everything below the ".env.local ONLY"
#                    divider goes here, NOT in .env. The app never reads
#                    .env.local, so DB_* or other app settings there do
#                    nothing.
#   .env.test.local  Integration tests only; template: .env.test.local.sample
#
# Copy to .env, fill in credentials, then: chmod 600 .env
# NEVER commit any env file to git

DB_HOST=hostname
DB_USER=database_user
DB_PASS=database_password
DB_NAME=database_name

# Overrides UserSpice's $_SESSION key names and remember-me cookie name
# (users/init.php). Only needed when running more than one local clone of
# this repo from the same host/port (e.g. Registry/ and Registry2/) — both
# share one PHP session (same PHPSESSID cookie, path=/) regardless of these
# vars, but without distinct $_SESSION keys, one clone's login/CSRF state
# silently clobbers the other's inside that shared session. Leave unset on
# a single-clone install, production, and test — the app falls back to its
# own existing hardcoded defaults (see users/init.php).
# SESSION_NAME=elan2
# TOKEN_NAME=token2
# REMEMBER_COOKIE_NAME=elan-remember2

# TURNSTILE_SITE_KEY=your_turnstile_site_key_here
# TURNSTILE_SECRET_KEY=your_turnstile_secret_key_here

# Admin notification / feedback-form recipient addresses (see #1067).
# Falls back to registrar@elanregistry.org if unset.
# ADMIN_EMAILS=registrar@elanregistry.org
# FEEDBACK_EMAIL=registrar@elanregistry.org

# Bearer token Brevo must present on every webhook call to
# app/api/webhooks/brevo.php (see #1887). Required for the receiver to accept
# any request — an empty/missing value rejects everything (fail-closed).
# BREVO_WEBHOOK_TOKEN=generate_a_long_random_secret

# Local-dev-only override: routes the Brevo PHP SDK to a local mock instead
# of the real Brevo API. Only takes effect when US_ENVIRONMENT=development
# (see docs/development/ENVIRONMENT.md). Point at the mock-brevo Docker
# Compose service: http://mock-brevo:8080/v3
# BREVO_API_HOST=http://mock-brevo:8080/v3

# Local Docker dev stack (docker-compose.yml; see
# docs/development/ENVIRONMENT.md "Docker Dev Environment" and
# docs/development/MAMP_TO_DOCKER.md). Pointing the app at the stack's `db`
# service:
# DB_HOST=db
# DB_PORT=3306
# Per-checkout host ports, read by Compose. Unset = Registry2's defaults
# (8002/8082/8090/8102). Registry/ uses the values below; each further
# checkout takes the next row of the table in ENVIRONMENT.md.
# CHECKOUT_NAME=Registry
# APP_HOST_PORT=8001
# PMA_HOST_PORT=8081
# MOCK_BREVO_HOST_PORT=8091
# LANDING_HOST_PORT=8101

# ============================================================================
# .env.local ONLY — everything below is read by Playwright
# (playwright.config*.js, scripts/playwright-auth-setup.js), never by the app.
# ============================================================================

# Playwright E2E test credentials for Local/Dev (used by playwright.config.js's
# and playwright.config.dev.js's `admin`/`logged-in-non-admin` projects, via
# tests/playwright/e2e/auth*.setup.js). Local MAMP accounts only — same
# E2E_<TIER>_<ROLE>_* naming scheme as the Test/Prod credentials below (#2059).
# Store real values only in .env.local (gitignored) — never commit real credentials.
# E2E_DEV_ADMIN_USERNAME=admin_test_user@example.com
# E2E_DEV_ADMIN_PASSWORD=changeme
# E2E_DEV_NONADMIN_USERNAME=nonadmin_test_user@example.com
# E2E_DEV_NONADMIN_PASSWORD=changeme2

# Playwright E2E test credentials for Test/Prod (issue #2035). Used by
# scripts/playwright-auth-setup.js to generate the pre-authenticated
# storageState files checked by tests/playwright/e2e/auth-staleness*.setup.js.
# These environments run HTTPS with an active Cloudflare Turnstile challenge,
# so login cannot happen live on every run (see docs/testing/PLAYWRIGHT_E2E.md)
# — a human must manually disable Turnstile, run the setup script once per
# tier/role, then re-enable it.
# Store real values only in .env.local (gitignored) — never commit real credentials.
# E2E_TEST_ADMIN_USERNAME=admin_test_user@example.com
# E2E_TEST_ADMIN_PASSWORD=changeme
# E2E_TEST_NONADMIN_USERNAME=nonadmin_test_user@example.com
# E2E_TEST_NONADMIN_PASSWORD=changeme2
# E2E_PROD_ADMIN_USERNAME=admin_prod_user@example.com
# E2E_PROD_ADMIN_PASSWORD=changeme3
# E2E_PROD_NONADMIN_USERNAME=nonadmin_prod_user@example.com
# E2E_PROD_NONADMIN_PASSWORD=changeme4

# Overrides the local Playwright baseURL (playwright.config.js and
# playwright.config.dev.js) for MAMP setups whose document root differs from
# the default. Must include a trailing slash. See docs/development/ENVIRONMENT.md.
# PLAYWRIGHT_BASE_URL=http://localhost:9999/ElanRegistry/Registry/
# For a Docker stack use its site port instead, e.g. http://localhost:8001/

# Car id the local Playwright specs open as their "standard" car
# (tests/playwright/fixtures.js). Defaults to 1; override when your local
# database has no car 1. A misspelled name silently falls back to 1.
# CAR_ID_STANDARD=1

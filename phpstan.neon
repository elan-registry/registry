includes:
    - phpstan-baseline.neon
    - vendor/phpstan/phpstan-phpunit/extension.neon

# PHPStan Configuration for Elan Registry
#
# Scans all project-owned PHP files. Paths are enumerated explicitly so
# that untracked upstream files in usersc/plugins/, usersc/templates/, and
# usersc/widgets/ are not picked up on developer machines.
#
# Usage:
#   vendor/bin/phpstan analyse
#   composer phpstan:baseline   # regenerate baseline (adds required flags)
#
# Documentation: https://phpstan.org/

parameters:
    level: 5

    # Test/prod run PHP 8.2 this cycle (#1968) while dev/CI run 8.4. PHPStan
    # has no independent version detection — without this, it silently
    # inherits composer.json's config.platform.php, which #1968 raised to
    # 8.4.0 for local dependency resolution. Left unpinned, that same change
    # would retarget analysis to 8.4 as a side effect, so 8.3/8.4-only syntax
    # (property hooks, asymmetric visibility, etc.) would pass CI clean and
    # then fatal on the 8.2 test/prod hosts. Pin explicitly to the deployment
    # floor so this stays a real guard regardless of what platform.php says.
    phpVersion: 80229

    # Explicit, stable path so CI can cache PHPStan's result cache across runs
    # (actions/cache in .github/workflows/static-analysis.yml) instead of
    # paying for a cold full-repo analysis on every PR. PHPStan invalidates
    # cache entries per-file by content hash, so a stale/mismatched cache
    # restore is harmless — worst case is a cache miss, not a wrong result.
    tmpDir: .phpstan-cache

    paths:
        # Application
        - app
        - database/migrations
        - database/seeds
        - docs
        - error
        - index.php
        - phinx.php
        - scripts
        - tests
        - z_us_root.php
        # UserSpice customizations (project-owned)
        - usersc/account.php
        - usersc/classes
        - usersc/includes
        - usersc/join.php
        - usersc/lang
        - usersc/login.php
        - usersc/oauth_client
        - usersc/oauth_server
        - usersc/plugins/ai_prompts/custom_prompts
        - usersc/plugins/hooker/hooks
        - usersc/scripts
        - usersc/templates/customizer/assets/child_themes
        - usersc/templates/customizer/file_nav_custom.php
        - usersc/templates/customizer/navigation.php
        - usersc/user_settings.php
        - usersc/userspice_core
        - usersc/views
        - usersc/widgets/settings
        - usersc/widgets/tools

    # Symbol sources that are NOT analysed themselves but must be resolvable.
    # The Brevo SDK and its Guzzle dependency ship vendored inside the
    # sendinblue plugin and are not wired into the project's own Composer
    # autoloader, so `excludePaths: */vendor/*` below leaves every Brevo\ and
    # GuzzleHttp\ class unknown. scanDirectories makes them resolvable for
    # callers (usersc/classes/Cron/BrevoEventReconciliationClient.php) without
    # pulling third-party code into the analysed set or the baseline.
    scanDirectories:
        - usersc/plugins/sendinblue/vendor/getbrevo/brevo-php/lib
        - usersc/plugins/sendinblue/vendor/guzzlehttp

    excludePaths:
        # analyseAndScan by default; listed under analyse: so that the
        # scanDirectories entries above stay resolvable. A plain excludePaths
        # entry removes files from symbol discovery as well as from analysis,
        # which would silently defeat scanDirectories for the vendored Brevo
        # SDK — third-party code is still never analysed or baselined.
        analyse:
            - */vendor/*
        analyseAndScan:
            - */node_modules/*
            - users/
            # Excluded because its placeholder code generates errors that can never be fixed;
            # keeping it out of scope prevents those errors from entering the baseline.
            - app/admin/scripts/fix/_TEMPLATE_Fix-Script.php
            # Test double for \User (#1566). Excluded so PHPStan never adopts its narrow
            # 2-method surface as the definition of \User project-wide — see the file's
            # own docblock for the full leak mechanism this prevents.
            - tests/unit/auth/_User_test_double.php

    treatPhpDocTypesAsCertain: false
    checkMissingTypehints: true
    checkExplicitMixedMissingReturn: true
    checkTooWideReturnTypesInProtectedAndPublicMethods: true
    checkUninitializedProperties: true

    # Baseline entries are strictly enforced: if an entry matches nothing, CI fails,
    # forcing removal of stale entries as errors are fixed (fix-when-you-touch-it).
    # Config-level suppressors below are exempt (reportUnmatched: false) because
    # they are broad framework noise patterns, not file-specific entries.
    reportUnmatchedIgnoredErrors: true

    ignoreErrors:
        # UserSpice framework classes loaded at runtime via init.php — not autoloadable
        -
            message: '#(unknown|Instantiated) class (DB|Token|Input|User|Redirect|Session|Cookie|Server|Validate|TOTPHandler|Config|Menu|RateLimit)#'
            reportUnmatched: false
        -
            message: '#invalid (return )?type (DB|Token|Input|User|Redirect|Session|Cookie|RateLimit)#'
            reportUnmatched: false

        # Method-call-shape errors on the same runtime-loaded classes above. Since
        # tests/ entered the scan path (#1555), PHPStan resolves calls on Token/Input
        # (still bare global test doubles inside the scanned tests/bootstrap-unit.php)
        # against whichever test double happens to declare a same-named global
        # class/method — narrower or differently-typed than the real runtime class —
        # and misreports call sites throughout the whole project, not just the test
        # file that defines the double. This is the same "unanalyzable at runtime"
        # root cause as the block above, just a different error shape it produces:
        # call-site mismatches (undefined method, wrong arg count, wrong arg type).
        # QueryResult was covered here too until #1585 deleted the bootstrap mock —
        # the name now appears nowhere in the project, so its patterns (and the
        # redundant-`===`-comparison pattern that fired only on its real-vs-stubbed
        # type) were removed. DB stays: its double is gone too, but the real class
        # is still referenced by production code and remains unanalyzable.
        # User is deliberately absent from these patterns: its one test double
        # lives in a file excluded from PHPStan's scan (#1566), so \User resolves to
        # "unknown class" instead — already covered by the block above, not this one.
        -
            message: '#Call to an undefined method (DB|Token|Input|Redirect|Session|Cookie|Server|Validate|TOTPHandler|Config|Menu|RateLimit)::\w+\(\)#'
            reportUnmatched: false
        -
            message: '#(Static m|M)ethod (DB|Token|Input|Redirect|Session|Cookie|Server|Validate|TOTPHandler|Config|Menu|RateLimit)::\w+\(\) invoked with#'
            reportUnmatched: false
        -
            message: '#of (method|class) (DB|Token|Input|Redirect|Session|Cookie|Server|Validate|TOTPHandler|Config|Menu|RateLimit)(::|\s)#'
            reportUnmatched: false
        -
            message: '#Call to method \w+\(\) on an unknown class RateLimit#'
            reportUnmatched: false

        # UserSpice framework functions loaded at runtime via init.php
        -
            message: '#Function (securePage|hasPerm|logger|currentUserId|checkMenu|lang|redirect|passwordStrength|isAdmin|email|usError|usSuccess|deleteUsers|logError|getSettings|checkRateLimit|recordRateLimit|fetchAllUsers|fetchUserDetails|checkPermission|sessionValMessages|currentPage|email_body|getMyHooks|getRateLimitErrorMessage|handleAuthFailure|handleAuthSuccess|hashVericode|includeHook|pluginActive|userSpicePasswordStrength|passwordsAllowed|safeJsonEncodeForJs|safeReturn|tokenHere|fetchUserPermissions|echousername|err|endCloak|isCloaked|passwordResetKillSessions) not found#'
            reportUnmatched: false

        # UserSpice legacy code patterns
        -
            message: '#Unsafe usage of new static\(\)#'
            reportUnmatched: false

        # Framework globals set by z_us_root.php, users/init.php, server_globals.php.
        # phpstan-bootstrap.php declares these but bootstrap scope is isolated —
        # page files still see them as undefined without this pattern.
        -
            message: '#Variable \$(abs_us_root|us_url_root|user|db|settings|php_self|is_https|host|method|request_uri|current_url|current_origin|remote_addr|referer|user_agent|argv|argc) might not be defined#'
            identifier: variable.undefined
            reportUnmatched: false

        # Relative require/require_once paths (e.g. ../../users/init.php) can't be
        # resolved at analysis time — these are valid runtime paths
        -
            message: '#Path in require(_once)?\(\) .+ is not a file or it does not exist\.$#'
            reportUnmatched: false

    bootstrapFiles:
        - phpstan-bootstrap.php

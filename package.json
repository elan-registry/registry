{
  "name": "elan_registry",
  "version": "1.0.0",
  "description": "This is code for the Lotus Elan Registry hosted at https://elanregistry.org. It is used in conjunction with Userspice (https://userspice.com) to build an online database for Lotus Elan and Lotus Elan +2 cars.",
  "main": "index.js",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "scripts": {
    "test": "echo '\n📋 Available Tests:\n\n  PHP Unit Tests (128 tests):\n    composer test:quick\n\n  E2E Tests - Production (24 tests):\n    npm run test:e2e              # All E2E tests on elanregistry.org\n    npm run test:e2e:not-logged-in  # Public pages only\n    npm run test:e2e:admin          # Authenticated admin tests\n    # No non-admin E2E npm script yet — logged-in project is infra-only\n    # until a non-admin spec exists (#2035)\n\n  E2E Tests - Test Environment (24 tests):\n    npm run test:e2e:test         # All E2E tests on test.elanregistry.org\n    npm run test:e2e:test:not-logged-in  # Public pages only\n    npm run test:e2e:test:admin          # Authenticated admin tests\n\n  Local Playwright Tests - Localhost (requires MAMP at http://localhost:9999/elan-registry):\n    npm run playwright:test       # All local tests\n    npm run playwright:security   # Security tests\n    npm run playwright:maps       # Maps & charts\n    npm run playwright:csp        # CSP validation\n    npm run playwright:mobile     # Mobile responsive\n\n  Note: Authenticated tests require E2E_DEV_* vars (Local/Dev) or E2E_TEST_*/E2E_PROD_* vars (Test/Prod) in .env.local\n'",
    "test:quick": "npm run playwright:security",
    "test:smoke": "npm run playwright:test",
    "playwright:install": "npx playwright install",
    "playwright:test": "playwright test",
    "playwright:security": "playwright test tests/playwright/security/",
    "playwright:maps": "playwright test tests/playwright/maps-charts.spec.js",
    "playwright:csp": "playwright test tests/playwright/csp-validation.spec.js",
    "playwright:mobile": "playwright test tests/playwright/mobile-responsive.spec.js",
    "playwright:headed": "playwright test --headed",
    "playwright:debug": "playwright test --debug",
    "playwright:report": "playwright show-report",
    "test:e2e": "playwright test --config=playwright.config.prod.js",
    "test:e2e:headed": "playwright test --config=playwright.config.prod.js --headed",
    "test:e2e:ui": "playwright test --config=playwright.config.prod.js --ui",
    "test:e2e:not-logged-in": "playwright test --config=playwright.config.prod.js --project=not-logged-in",
    "test:e2e:admin": "playwright test --config=playwright.config.prod.js --project=admin",
    "test:e2e:report": "playwright show-report playwright-report-e2e",
    "test:e2e:test": "playwright test --config=playwright.config.test.js",
    "test:e2e:test:headed": "playwright test --config=playwright.config.test.js --headed",
    "test:e2e:test:ui": "playwright test --config=playwright.config.test.js --ui",
    "test:e2e:test:not-logged-in": "playwright test --config=playwright.config.test.js --project=not-logged-in",
    "test:e2e:test:admin": "playwright test --config=playwright.config.test.js --project=admin",
    "test:e2e:test:report": "playwright show-report playwright-report-e2e-test",
    "test:e2e:dev": "playwright test --config=playwright.config.dev.js",
    "test:e2e:dev:headed": "playwright test --config=playwright.config.dev.js --headed",
    "test:e2e:dev:ui": "playwright test --config=playwright.config.dev.js --ui",
    "test:e2e:dev:not-logged-in": "playwright test --config=playwright.config.dev.js --project=not-logged-in",
    "test:e2e:dev:admin": "playwright test --config=playwright.config.dev.js --project=admin",
    "test:e2e:dev:report": "playwright show-report playwright-report-e2e-dev",
    "build": "node scripts/build.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elan-registry/registry.git"
  },
  "keywords": [],
  "author": "",
  "license": "AGPL-3.0-only",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/elan-registry/registry/issues"
  },
  "homepage": "https://github.com/elan-registry/registry#readme",
  "dependencies": {
    "@versatiles/style": "^5.13.1",
    "chart.js": "4.5.1",
    "datatables.net-bs5": "3.0.3",
    "datatables.net-fixedheader-bs5": "5.0.0",
    "datatables.net-responsive-bs5": "4.0.2",
    "esbuild": "^0.28.2",
    "filepond": "^4.32.12",
    "filepond-plugin-file-validate-size": "^2.2.8",
    "filepond-plugin-file-validate-type": "^1.2.9",
    "filepond-plugin-image-exif-orientation": "^1.0.11",
    "filepond-plugin-image-preview": "^4.6.12",
    "filepond-plugin-image-resize": "^2.0.10",
    "filepond-plugin-image-transform": "^3.8.8",
    "maplibre-gl": "6.7.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "dotenv": "^17.4.2",
    "eslint": "^10.9.1",
    "markdownlint-cli2": "^0.23.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.2": true
  }
}

# Integration-test database, read ONLY by tests/bootstrap-integration.php.
# Copy to .env.test.local and chmod 600. Must name a disposable schema that
# is not the app's database: the suite writes to it and
# scripts/provision-schema.sh drops and rebuilds it. The name must contain
# "test".
#
# Set all five keys, even ones equal to .env's. A missing key is backfilled
# from .env by users/init.php, which can point the suite at the wrong
# database. MAMP: DB_HOST must be host:port (e.g. 127.0.0.1:8889), because
# UserSpice builds its connection from DB_HOST alone. Docker: DB_HOST=db,
# DB_PORT=3306, and DB_USER/DB_PASS the same as .env's.
# See docs/development/ENVIRONMENT.md "Which File Is Read by What".
DB_HOST=hostname
DB_PORT=8889
DB_USER=database_user
DB_PASS=database_password
DB_NAME=database_name

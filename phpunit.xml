<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/13.4/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         colors="true"
         processIsolation="false"
         stopOnFailure="false"
         failOnDeprecation="true"
         cacheDirectory=".phpunit.cache"
         backupGlobals="false">
    
    <testsuites>
        <!-- Combined unit test suite (all unit tests) -->
        <testsuite name="Unit">
            <directory>tests/unit</directory>
        </testsuite>

        <!-- Database integration tests (run separately with real DB) -->
        <testsuite name="Integration">
            <directory>tests/integration</directory>
        </testsuite>
    </testsuites>
    
    <php>
        <env name="TESTING" value="true"/>
        <ini name="error_reporting" value="E_ALL"/>
        <ini name="display_errors" value="1"/>
        <ini name="display_startup_errors" value="1"/>
        <!-- Explicit, never inherited from php.ini (#2134). Why, and why 512M:
             tests/README.md "Suite Dies with ...". Keep every phpunit*.xml in
             step; Issue2134RegressionTest enforces it. -->
        <ini name="memory_limit" value="512M"/>
    </php>
    
    <!-- Every PHP file tracked in git outside tests/ (#2491). Untracked
         upstream code stays outside, so ignoreIndirectDeprecations skips its
         deprecations. Keep every phpunit*.xml in step;
         Issue2491RegressionTest fails when a tracked file is not covered. -->
    <source ignoreIndirectDeprecations="true">
        <include>
            <directory>app</directory>
            <directory>database</directory>
            <directory>docs</directory>
            <directory>error</directory>
            <directory>scripts</directory>
            <directory>stubs</directory>
            <directory>tools</directory>
            <directory>usersc/classes</directory>
            <directory>usersc/includes</directory>
            <directory>usersc/lang</directory>
            <directory>usersc/oauth_client</directory>
            <directory>usersc/oauth_server</directory>
            <directory>usersc/scripts</directory>
            <directory>usersc/userspice_core</directory>
            <directory>usersc/views</directory>
            <directory>usersc/widgets</directory>
            <directory>usersc/plugins/ai_prompts/custom_prompts</directory>
            <directory>usersc/plugins/hooker/hooks</directory>
            <directory>users/cron</directory>
            <file>index.php</file>
            <file>phinx.php</file>
            <file>phpstan-bootstrap.php</file>
            <file>z_us_root.php</file>
            <file>users/init.php</file>
            <file>usersc/account.php</file>
            <file>usersc/join.php</file>
            <file>usersc/login.php</file>
            <file>usersc/user_settings.php</file>
            <file>usersc/templates/customizer/assets/child_themes/dashboard.php</file>
            <file>usersc/templates/customizer/assets/child_themes/elanregistry.php</file>
            <file>usersc/templates/customizer/file_nav_custom.php</file>
            <file>usersc/templates/customizer/navigation.php</file>
        </include>
        <exclude>
            <directory>vendor</directory>
            <directory>tests</directory>
        </exclude>
    </source>
</phpunit>

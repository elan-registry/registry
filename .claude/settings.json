{
  "enabledPlugins": {
    "commit-commands@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "playwright@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "allow": [
      "Bash(vendor/bin/phpstan analyse *)",
      "Bash(composer test:full *)",
      "Bash(composer test:quick *)",
      "Bash(composer test:integration *)",
      "Bash(composer check:docs *)",
      "Bash(gh label list *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/guard-deploy-push.sh"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/guard-private-paths.sh"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/guard-upstream-paths.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/phpstan-on-edit.sh",
            "timeout": 120
          }
        ]
      }
    ]
  }
}

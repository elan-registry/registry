!usersc/templates/customizer/assets/child_themes/
usersc/templates/customizer/assets/child_themes/*
!usersc/templates/customizer/assets/child_themes/*.php
# Timestamped CSS auto-generated by Customizer UI — only the active theme is tracked
usersc/templates/customizer/assets/child_themes/*-*.css
!usersc/templates/customizer/assets/child_themes/elanregistry-20260504123354.css
!usersc/templates/customizer.css
usersc/widgets/*
!usersc/widgets/settings/
usersc/widgets/settings/*.png
!usersc/widgets/tools/
usersc/widgets/tools/*.png
install/*

########################################
# Vendor & Dependencies
########################################
vendor/
w/
usersc/vendor/
composer.phar
*.phar

# database/vendor/ is not a dependency directory — it holds the vendored stock
# UserSpice schema that provisioning applies before Phinx runs. The `vendor/`
# rule above matches any directory of that name at any depth, so it has to be
# re-included explicitly or the schema-of-record would never be committed.
!database/vendor/


#!/bin/bash

#
# Pre-push hook:
#   1. BLOCKING integration-test gate (#1439) — see below.
#   2. Non-blocking reminder to run /review-pr before pushing a feature branch.
#
# Rationale for the reminder: CI runs a lightweight Sonnet-backed review on
# PRs targeting milestone branches and relies on the author having done a
# deep multi-agent review locally. Running /review-pr on your Claude Max/Pro
# subscription catches issues before CI cycles burn tokens on every push.
#
# The reminder section NEVER blocks a push. It only prints on the first push
# of a branch that looks like feature / issue work (issue/*, claude/*,
# feat/*, fix/*, chore/*, refactor/*) when the remote branch does not yet
# exist. Set SKIP_REVIEW_PR_REMINDER=1 to silence it.
#
# The integration-gate section DOES block a push — see its comment block
# below for scope, the remote restriction, and the --no-verify escape hatch.
#

# Read ref updates from stdin ONCE, into a variable. git pipes the ref list
# to pre-push hooks as a one-shot stream — a shell pipe cannot be rewound
# once read, so with two sections each needing the full ref list (the gate
# below, and the reminder that already existed), the list has to be captured
# up front and each section loops over the saved copy instead of stdin
# directly.
ref_updates="$(cat)"

# git passes the pushed-to remote's name as $1 (its URL as $2) — separate
# from the per-ref stdin data above.
remote_name="${1:-}"

# =============================================================================
# 1. Integration-test gate (#1439, #2160)
#
# Restricted to the `origin` remote (GitHub). `prod` and `test` are deploy
# remotes (see Registry/CLAUDE.md) that receive already-merged, CI-verified
# `main`; gating them would tie deploy success to local test-DB state (#1591).
# Deletes and blank stdin lines are skipped.
#
# This hook is the only place the integration suite runs (CI has no test
# database), so when in doubt it RUNS the suite: a wrongful skip is the worst
# outcome, an unnecessary ~20s run is acceptable.
#
# A push is gated when its diff touches ^(app|usersc/classes|tests/integration)/.*\.php$.
# The diff for each ref is:
#
#   - refs/heads/main: remote_sha..local_sha, or the merge-base with
#     origin/main when the remote tip is unknown locally.
#   - An existing ref whose remote tip exists locally: remote_sha..local_sha.
#   - A new ref (remote_sha all zeros), or an existing ref whose remote tip is
#     not present locally: the merge-base with the closest parent branch
#     (see _pick_closest_base).
#
# All file lists use `--no-renames`, so a rename reports both the deleted and
# the added path (`git mv app/a.php lib/a.php` still gates app/a.php).
# An unresolvable base or any git failure while computing the list RUNS the
# suite with a WARNING (fail-safe).
#
# Accepted trade-offs:
#   - Merging main or the parent branch into a branch runs the suite when the
#     merge brings in gated files.
#   - A remote tip pushed with --no-verify or SKIP_INTEGRATION_GATE=1 is not
#     re-checked by a later push; only remote_sha..local_sha is.
#
# WHERE IT RUNS. On the host by default. When .env.test.local has DB_HOST=db
# (the Docker dev stack), inside this checkout's `app` container instead,
# via `docker compose exec`: `db` resolves only on the Compose network. A
# stopped stack blocks the push with "docker compose up -d" rather than
# skipping. See _integration_runner / _run_integration_suite (#2171).
#
# The suite (composer test:integration, against the schema in
# .env.test.local) tests the WORKING TREE, so it runs at most ONCE per hook
# invocation and later refs reuse its exit code; pushing a ref that is not
# HEAD prints a warning. Any non-zero exit blocks the push — a test failure
# or an unreachable test DB (tests/bootstrap-integration.php fails loudly).
#
# CACHE. $GIT_DIR/integration-passed holds one key — the pushed tree SHA plus
# the test DB_NAME — for the most recent pass. It is written only when the
# suite exits 0, the pushed commit is HEAD and the working tree has no
# modified or untracked (non-ignored) files, so
# it only skips a re-push of an identical tree (e.g. a retried force push).
# Clear it with:
#   rm "$(git rev-parse --git-path integration-passed)"
#
# Bypass: `git push --no-verify` skips the whole hook; SKIP_INTEGRATION_GATE=1
# skips only this section and keeps the /review-pr reminder below.
# =============================================================================

# The optional quotes match a path git still C-quotes under
# core.quotepath=false (one containing a tab, newline, quote or backslash).
integration_gate_paths='^"?(app|usersc/classes|tests/integration)/.*\.php"?$'
zero_sha="0000000000000000000000000000000000000000"
gate_failed=0

# Changed paths between two commits, unquoted (non-ASCII names included), with
# renames reported as delete + add. Propagates git's exit status so callers
# can tell "no changes" from "failed".
_diff_names() {
    git -c core.quotepath=false diff --no-renames --name-only "$@"
}

# Picks the closest true parent branch of $1 and echoes its merge-base with
# $1. Issue branches fork from a `milestone/*` branch, not `main`, so every
# candidate — local `refs/heads/milestone/*`, `refs/remotes/origin/milestone/*`
# and origin/main — is ranked together, and the one with the FEWEST commits
# between its merge-base and $1 wins. Local and remote branches of the same
# name are not deduped; the ranking already prefers the closer one.
#
# Rejected candidates:
#   - one whose tip EQUALS $1, except origin/main (#2024: a branch with no
#     commits beyond main must still resolve via main). Any other candidate
#     at $1's tip (e.g. a milestone branch fast-forwarded to the issue branch)
#     would win with 0 commits and empty the diff (#2160);
#   - one that has $1 as an ancestor, i.e. was cut from $1's own tip.
# A candidate that moved on after $1 forked from it is still accepted — it is
# $1's true parent even though $1 is not reachable from it (PR #1767).
#
# $2 and $3, both optional, are the remote and local names of the branch
# being pushed (they differ for `git push origin feature:milestone/x`). Any
# candidate equal to either, or to origin/<either>, is skipped so a
# `milestone/*` push never resolves to itself (#2160).
#
# Echoes the winning base SHA, and the winning candidate + commit count to
# stderr. Returns non-zero (echoing nothing) if no candidate resolves.
_pick_closest_base() {
    local target="$1"
    local self_remote="${2:-}" self_local="${3:-}"
    local best_base="" best_count="" best_candidate=""
    local candidate base count candidate_sha target_sha

    target_sha="$(git rev-parse --verify --quiet "${target}^{commit}" 2>/dev/null)" || return 1
    [ -n "$target_sha" ] || return 1

    while IFS= read -r candidate; do
        [ -z "$candidate" ] && continue
        # Never rank the pushed branch against itself — see above.
        case "$candidate" in
            "$self_remote"|"origin/$self_remote"|"$self_local"|"origin/$self_local")
                continue
                ;;
        esac
        base="$(git merge-base "$target_sha" "$candidate" 2>/dev/null)" || continue
        candidate_sha="$(git rev-parse "$candidate" 2>/dev/null)" || continue
        # See the function comment above for both rejection rules.
        if [ "$target_sha" = "$candidate_sha" ]; then
            [ "$candidate" = "origin/main" ] || continue
        elif git merge-base --is-ancestor "$target_sha" "$candidate" 2>/dev/null; then
            continue
        fi
        count="$(git rev-list --count "$base".."$target_sha" 2>/dev/null)" || continue
        case "$count" in
            ''|*[!0-9]*)
                echo "  WARNING: unexpected 'git rev-list --count' output for candidate '$candidate': '$count' — skipping it." >&2
                continue
                ;;
        esac
        if [ -z "$best_count" ] || [ "$count" -lt "$best_count" ]; then
            best_base="$base"
            best_count="$count"
            best_candidate="$candidate"
        fi
    done <<< "$(git for-each-ref --format='%(refname:short)' 'refs/heads/milestone/*' 'refs/remotes/origin/milestone/*' 2>/dev/null; echo 'origin/main')"

    if [ -n "$best_base" ]; then
        echo "  (merge-base resolved via closest branch: $best_candidate, $best_count commit(s) ahead)" >&2
        printf '%s\n' "$best_base"
        return 0
    fi
    return 1
}

# Echoes the base to diff a pushed ref against (see the section header for
# the rules). Returns 1, echoing nothing, when nothing resolves; the caller
# then RUNS the suite.
#
# Args: $1 = local_sha, $2 = the remote ref being updated, $3 = remote_sha,
# $4 = the local branch name (both optional).
_gate_base_for_ref() {
    local local_sha="$1" remote_ref="$2" remote_sha="${3:-}" local_branch="${4:-}"
    local branch="${remote_ref#refs/heads/}"
    local base

    if [ -n "$remote_sha" ] && [ "$remote_sha" != "$zero_sha" ] \
        && git cat-file -e "${remote_sha}^{commit}" 2>/dev/null; then
        printf '%s\n' "$remote_sha"
        return 0
    fi

    if [ "$branch" = "main" ]; then
        if base="$(git merge-base origin/main "$local_sha" 2>/dev/null)" && [ -n "$base" ]; then
            printf '%s\n' "$base"
            return 0
        fi
        echo "  WARNING: could not resolve a base for '$remote_ref' (remote tip unknown, no origin/main?)." >&2
        return 1
    fi

    if base="$(_pick_closest_base "$local_sha" "$branch" "$local_branch")"; then
        printf '%s\n' "$base"
        return 0
    fi

    echo "  WARNING: could not resolve a parent merge-base for '$remote_ref' (no origin/main, no milestone/* branch?)." >&2
    return 1
}

# Echoes the gated files changed between $1 (base) and $2 (local_sha).
# Returns 1 after a WARNING if the diff fails, so the caller RUNS the suite
# rather than reading a failure as "no changes".
_gated_files_for_ref() {
    local base="$1" local_sha="$2" files

    if ! files="$(_diff_names "$base" "$local_sha" 2>/dev/null)"; then
        echo "  WARNING: 'git diff $base $local_sha' failed." >&2
        return 1
    fi
    printf '%s\n' "$files" | grep -E "$integration_gate_paths"
    return 0
}

# Cache key for a recorded pass: the pushed TREE (not the commit — a reword
# or an amended message doesn't change what the tests exercise) plus the test
# database name, so pointing .env.test.local at a different schema invalidates
# it. Echoes nothing (= caching disabled) when the file or the value is
# missing, rather than keying on a blank DB name.
_integration_cache_key() {
    local local_sha="$1" tree env_file db_name
    tree="$(git rev-parse "${local_sha}^{tree}" 2>/dev/null)" || return 0
    [ -z "$tree" ] && return 0

    env_file="$(git rev-parse --show-toplevel 2>/dev/null)/.env.test.local"
    [ -f "$env_file" ] || return 0

    db_name="$(grep -E '^[[:space:]]*DB_NAME[[:space:]]*=' "$env_file" 2>/dev/null | tail -n 1)"
    db_name="${db_name#*=}"
    db_name="$(printf '%s' "$db_name" | tr -d '\r"'"'" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"
    [ -z "$db_name" ] && return 0

    printf '%s %s\n' "$tree" "$db_name"
}

_integration_cache_file() {
    git rev-parse --git-path integration-passed 2>/dev/null
}

# Returns 0 when $1 (a non-empty key) matches the recorded pass.
_integration_cache_hit() {
    local key="$1" file
    [ -z "$key" ] && return 1
    file="$(_integration_cache_file)"
    [ -n "$file" ] && [ -f "$file" ] || return 1
    [ "$(cat "$file" 2>/dev/null)" = "$key" ]
}

# Records a pass. Refuses unless the key is non-empty AND the pushed commit
# is HEAD AND the working tree has no modified tracked files and no untracked,
# non-ignored files — the suite ran against the WORKING TREE, so a pass that
# depended on an uncommitted or un-added file (e.g. a new app/*.php never
# `git add`ed) must not be cached against a tree that lacks it. A failing
# `git status` also refuses. Written via temp file + mv so a crash mid-write
# can't leave a truncated key that silently never matches.
_integration_cache_record() {
    local key="$1" local_sha="$2" file tmp status_out
    [ -n "$key" ] || return 1
    [ "$local_sha" = "$(git rev-parse HEAD 2>/dev/null)" ] || return 1
    status_out="$(git status --porcelain 2>/dev/null)" || return 1
    [ -z "$status_out" ] || return 1

    file="$(_integration_cache_file)"
    [ -n "$file" ] || return 1
    tmp="${file}.tmp.$$"
    printf '%s\n' "$key" > "$tmp" 2>/dev/null || return 1
    mv -f "$tmp" "$file" 2>/dev/null || { rm -f "$tmp"; return 1; }
    return 0
}

# Echoes where the suite must run: "docker" when .env.test.local points at
# the Docker Compose `db` service (DB_HOST=db, with or without a :port),
# otherwise "host". `db` resolves only on the Compose network, and the `db`
# service publishes no host port, so a host-side run can never reach it
# (#2171). INTEGRATION_GATE_RUNNER=host|docker overrides the detection.
_integration_runner() {
    local env_file db_host
    case "${INTEGRATION_GATE_RUNNER:-}" in
        host|docker)
            printf '%s\n' "$INTEGRATION_GATE_RUNNER"
            return 0
            ;;
    esac

    env_file="$(git rev-parse --show-toplevel 2>/dev/null)/.env.test.local"
    db_host="$(grep -E '^[[:space:]]*DB_HOST[[:space:]]*=' "$env_file" 2>/dev/null | tail -n 1)"
    db_host="${db_host#*=}"
    db_host="$(printf '%s' "$db_host" | tr -d '\r"'"'" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"
    db_host="${db_host%%:*}"

    if [ "$db_host" = "db" ]; then
        echo "docker"
    else
        echo "host"
    fi
}

# Runs the integration suite where the test database is reachable and
# returns its exit status. In Docker mode it runs inside this checkout's
# `app` container (as www-data, see docker-compose.yml's header), and a
# missing `docker` or a stopped stack is a non-zero return with an
# actionable message — never a silent skip.
_run_integration_suite() {
    if [ "$(_integration_runner)" = "docker" ]; then
        if ! command -v docker >/dev/null 2>&1; then
            echo "  .env.test.local points at the Docker 'db' service (DB_HOST=db), but 'docker' is not on PATH." >&2
            return 1
        fi
        if [ -z "$(docker compose ps --status running -q app 2>/dev/null)" ]; then
            echo "  .env.test.local points at the Docker 'db' service, but this checkout's stack is not running." >&2
            echo "  Start it with: docker compose up -d" >&2
            return 1
        fi
        echo "  (running in the Docker 'app' container: .env.test.local has DB_HOST=db)"
        docker compose exec -T -u www-data app composer test:integration
        return $?
    fi
    composer test:integration
}

if [ "${SKIP_INTEGRATION_GATE:-}" = "1" ]; then
    echo ""
    echo "  Integration-test gate SKIPPED (SKIP_INTEGRATION_GATE=1)."
    echo ""
else
# The suite tests the working tree, not any particular ref, so it runs at
# most once per invocation; later refs reuse this result.
suite_ran=0
suite_status=0

while read -r local_ref local_sha remote_ref remote_sha; do
    # Blank line (git can send one on an up-to-date push) or a delete.
    [ -z "$local_sha" ] && continue
    [ "$local_sha" = "$zero_sha" ] && continue

    # Restricted to origin — see the comment block above this loop.
    if [ "$remote_name" != "origin" ]; then
        continue
    fi

    branch="${local_ref#refs/heads/}"

    gated_status=0
    if base="$(_gate_base_for_ref "$local_sha" "${remote_ref:-$local_ref}" "$remote_sha" "$branch")"; then
        gated_files="$(_gated_files_for_ref "$base" "$local_sha")" || gated_status=1
    else
        gated_status=1
    fi
    if [ "$gated_status" -ne 0 ]; then
        # Fail-safe: we cannot tell what changed. Run rather than skip — a
        # missed gate is the failure mode this hook exists to prevent.
        echo "  Integration gate will RUN for '$branch' anyway (fail-safe)." >&2
        gated_files="unresolved-base"
    fi

    if [ -z "$gated_files" ]; then
        echo "  Integration gate: no gated changes on '$branch' vs ${base:-parent} — skipping."
        continue
    fi

    cache_key="$(_integration_cache_key "$local_sha")"
    if _integration_cache_hit "$cache_key"; then
        cat <<EOF

  Integration gate: skip — this exact tree already passed the integration
  suite against the configured test database.

  Force a re-run with: rm "\$(git rev-parse --git-path integration-passed)"

EOF
        continue
    fi

    if [ "$local_sha" != "$(git rev-parse HEAD 2>/dev/null)" ]; then
        echo "  WARNING: '$branch' ($local_sha) is not HEAD — the suite tests the working tree (HEAD), not the pushed commit." >&2
    fi

    if [ "$suite_ran" -eq 0 ]; then
        cat <<EOF

  Integration-test gate: push to '$branch' touches app/, usersc/classes/, or
  tests/integration/. Running the full integration suite before allowing this
  push (composer test:integration, ~20s against the test schema)...

EOF
        suite_ran=1
        # </dev/null: the loop reads the remaining refs from stdin, so a
        # child that drained it would silently end the loop un-gated.
        if _run_integration_suite </dev/null; then
            suite_status=0
        else
            suite_status=1
        fi
    fi

    if [ "$suite_status" -ne 0 ]; then
        cat <<EOF

  BLOCKED: integration suite failed (or the test database was unreachable —
  check the output above). Push aborted.

  Fix the failure, or bypass with: git push --no-verify

EOF
        gate_failed=1
    else
        _integration_cache_record "$cache_key" "$local_sha" || true
    fi
done <<< "$ref_updates"
fi

if [ "$gate_failed" -eq 1 ]; then
    exit 1
fi

# =============================================================================
# 2. Non-blocking /review-pr reminder (pre-existing behavior, unchanged)
# =============================================================================

if [ -n "${SKIP_REVIEW_PR_REMINDER:-}" ]; then
    exit 0
fi

reminder_shown=0
while read -r local_ref local_sha remote_ref remote_sha; do
    # Skip deletes
    if [ "$local_sha" = "0000000000000000000000000000000000000000" ]; then
        continue
    fi

    branch="${local_ref#refs/heads/}"

    # Only remind on branches that look like feature / issue work
    case "$branch" in
        issue/*|claude/*|feat/*|fix/*|chore/*|refactor/*)
            ;;
        *)
            continue
            ;;
    esac

    # Only remind on the first push (remote ref is all-zeros).
    # Use a flag instead of break so all refs are evaluated — on a
    # multi-branch push a later ref may be the new one that needs the reminder.
    if [ "$remote_sha" = "0000000000000000000000000000000000000000" ] && [ "$reminder_shown" -eq 0 ]; then
        cat <<EOF

  Heads up: first push of branch '$branch'.

  Consider running /review-pr locally before pushing. The CI on this PR is
  a lightweight backstop that assumes a deep multi-agent review already
  happened on your machine.

  See docs/development/CODING_STANDARDS.md and CLAUDE.md for the workflow.

  (Silence this reminder with SKIP_REVIEW_PR_REMINDER=1 git push ...)

EOF
        reminder_shown=1
    fi
done <<< "$ref_updates"

exit 0

<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/12.0/phpunit.xsd"
         bootstrap="tests/bootstrap-integration.php"
         colors="true"
         processIsolation="false"
         stopOnFailure="false"
         cacheDirectory=".phpunit.cache"
         backupGlobals="false">

    <testsuites>
        <!-- Integration tests - require UserSpice framework and database -->
        <testsuite name="Integration">
            <directory>tests/integration</directory>
        </testsuite>
    </testsuites>

    <groups>
        <!-- live-network: makes real outbound HTTP calls to third-party geocoding
             providers (LocationServiceTest.php, issue #1759), excluded from the
             default run so a local integration run never blocks on transient
             network issues, rate limits, or upstream downtime. See
             LocationServiceTest.php's class docblock for the explicit-run
             command. RobotsTxtAsServedTest and VendorBootstrapMapsScriptTest
             carry the same tag at class level for the same reason.

             known-broken: pre-existing failures with an open tracking issue,
             tagged as a temporary, visible escape hatch (see tests/README.md).

             CAUTION: in PHPUnit 12, a CLI exclude-group flag REPLACES this
             list outright rather than adding to it
             (vendor/phpunit/phpunit/src/TextUI/Configuration/Merger.php:797-805),
             so composer scripts running this config must not pass that flag
             at all — doing so would silently re-enable live-network. The
             group flag still opts a group back in; tests/README.md's
             "Second CLI gotcha" section has the exact command to copy
             (an XML comment cannot contain a literal double hyphen, so it
             is not reproduced here). -->
        <exclude>
            <group>live-network</group>
            <group>known-broken</group>
        </exclude>
    </groups>

    <php>
        <env name="TESTING" value="true"/>
        <env name="INTEGRATION_TEST_SUITE" value="true"/>
        <ini name="error_reporting" value="E_ALL"/>
        <ini name="display_errors" value="1"/>
        <ini name="display_startup_errors" value="1"/>
        <!-- Explicit, so a run never depends on the ambient php.ini (128M on a
             default host CLI). Each suite runs in one process, and at 128M the
             unit suite (peak ~126MB) dies mid-run with no summary line (#2134).
             PHPUnit applies this with ini_set(), overriding php.ini and any
             `php -d memory_limit`, so this is the one place to change it; keep
             all three phpunit*.xml configs in step. -->
        <ini name="memory_limit" value="512M"/>
    </php>

    <source>
        <include>
            <directory>usersc/classes</directory>
            <directory>app</directory>
        </include>
        <exclude>
            <directory>vendor</directory>
            <directory>users</directory>
            <directory>FIX</directory>
            <directory>tests</directory>
            <file>usersc/classes/test_class.php</file>
        </exclude>
    </source>
</phpunit>
